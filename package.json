{
  "name": "@formulavize/compiler-frontend-fiz",
  "version": "1.1.0",
  "description": "Compiler frontend for the fiz language",
  "keywords": [
    "fiz",
    "ast",
    "dag",
    "compiler"
  ],
  "homepage": "https://github.com/formulavize/compiler-frontend-fiz#readme",
  "bugs": {
    "url": "https://github.com/formulavize/compiler-frontend-fiz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formulavize/compiler-frontend-fiz.git"
  },
  "license": "MIT",
  "author": "anthologen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "run-s build test",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:format": "prettier . --check",
    "format": "prettier . --write",
    "all": "run-s build test"
  },
  "dependencies": {
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@formulavize/lang-fiz": "^2.3.3",
    "@lezer/common": "^1.5.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@formulavize/lang-fiz": "^2.3.1",
    "@lezer/common": "^1.5.5"
  },
  "module": "dist/index.js",
  "sideEffects": false
}
